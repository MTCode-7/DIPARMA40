# ============================================================
# DI PARMA | مثال على ملف البيئة
# انسخ هذا الملف إلى .env وعدّل القيم
# ============================================================

APP_ENV=local
APP_DEBUG=true
APP_NAME="DI PARMA Gateway"
APP_TIMEZONE=Asia/Dubai

# local: http://localhost/DIPARMA8
# production: https://yourdomain.com

DB_HOST=localhost
DB_PORT=3306
DB_NAME=diparma_gateway
DB_USER=root
DB_PASS=
DB_PREFIX=dp_

ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_32_CHARS
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5

WISE_API_KEY=
WISE_ENVIRONMENT=live

# Exchange integrations
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=
CRYPTOCOM_API_URL=https://api.crypto.com/exchange/v1
SFOX_API_TOKEN=
SFOX_API_URL=https://api.sfox.com/v1

# TRON: Hot Wallet sends net settlement; Ledger receives only.
TRONGRID_API_KEY=
HOT_WALLET_TRC20_ADDRESS=TKST5Ug2UtAq6iQ8wVzy7tTah1FRgWaWYn
HOT_WALLET_TRC20_KEY=
LEDGER_TRC20_ADDRESS=TEwLFWhwk55b7PuFfzgH1H2f3xs3pLgLn2
# Double gateway fee before net→USDT (3 becomes 6). Net goes to Ledger as USDT.
GATEWAY_FEE_MULTIPLIER=2
SETTLEMENT_ASSET=USDT

# Optional bank settlement details (never commit real values)
JPMORGAN_BENEFICIARY=
JPMORGAN_ACCOUNT=
JPMORGAN_ROUTING=
JPMORGAN_SWIFT=CHASUS33
JPMORGAN_BANK_NAME=JP Morgan Chase Bank N.A.

# Unusual Whales market data (server-side only)
UNUSUAL_WHALES_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENVIRONMENT=live

# Square — https://developer.squareup.com / https://app.squareup.com
# Web Payments SDK needs APPLICATION_ID + LOCATION_ID (browser) and ACCESS_TOKEN (server).
# Production only: Application ID sq0idp- + production token + SQUARE_ENVIRONMENT=production + ACTIVE Location.
# connect.squareup.com + web.squarecdn.com. Never probe sandbox with a live token.
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_API_KEY=
SQUARE_SECRET_KEY=
SQUARE_ENVIRONMENT=production
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_SUCCESS_URL=https://diparmas.com/payment_success.php
SQUARE_CANCEL_URL=https://diparmas.com/payment_cancelled.php
SQUARE_WEBHOOK_URL=https://diparmas.com/api/webhook.php?gateway=square

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_SECRET is accepted for backward compatibility only.
PAYPAL_ENVIRONMENT=live
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_URL=https://your-domain.example/api/paypal.php?action=webhook

WEBHOOK_HMAC_SECRET=CHANGE_THIS_TO_RANDOM_SECRET
WEBHOOK_VERIFY_SIGNATURE=true
WEBHOOK_USE_ASYNC_PROCESSING=true
WISE_WEBHOOK_PUBLIC_KEY=
WHOP_WEBHOOK_SECRET=

# ============================================================
# PayRam Configuration
# ============================================================
PAYRAM_API_KEY=
PAYRAM_WEBHOOK_SECRET=
SITE_URL=https://diparmas.com
APP_URL=https://diparmas.com
NUVEI_PUBLIC_URL=https://diparmas.com
NUVEI_SUCCESS_URL=https://diparmas.com/nuvei-success.php
NUVEI_FAILURE_URL=https://diparmas.com/nuvei-fail.php
NUVEI_PENDING_URL=https://diparmas.com/nuvei-pending.php
NUVEI_BACK_URL=https://diparmas.com/nuvei-back.php
NUVEI_WEBHOOK_URL=https://diparmas.com/api/nuvei_dmn.php

# Verifone VX 675 — Verix V + Nuvei Payment App + key injection
# Keys are injected by Nuvei (RKI/KIF) into the terminal HSM. Do not put PEK/IPEK here.
# Set both flags to 1 only after Nuvei has installed the Payment App and injected keys.
NUVEI_POS_PAYMENT_APP=
NUVEI_POS_KEYS_INJECTED=
NUVEI_POS_TID=
NUVEI_POS_MID=
# Self-hosted PayRam node (card-to-crypto onramp requires Base + Cards enabled in dashboard)
PAYRAM_BASE_URL=http://65.2.184.57:8080

# Local XAMPP ↔ remote production — withdrawals + webhooks from both
PEER_ENABLED=true
PEER_LOCAL_URL=http://localhost:8080/DIPARMA40
PEER_REMOTE_URL=https://diparmas.com
PEER_SYNC_SECRET=CHANGE_THIS_TO_RANDOM_PEER_SECRET

# Auto Update — production pulls origin/main (webhook + cron + admin)
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_BRANCH=main
AUTO_UPDATE_SECRET=CHANGE_THIS_TO_RANDOM_AUTO_UPDATE_SECRET
