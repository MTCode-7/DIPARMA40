# ============================================================
# DI PARMA | مثال على ملف البيئة
# انسخ هذا الملف إلى .env وعدّل القيم
# ============================================================

APP_ENV=local
APP_DEBUG=true
APP_NAME="DI PARMA Gateway"
APP_TIMEZONE=Asia/Dubai

# local: http://localhost/DIPARMA8
# production: https://yourdomain.com
APP_URL=http://localhost/DIPARMA8

DB_HOST=localhost
DB_PORT=3306
DB_NAME=diparma_gateway
DB_USER=root
DB_PASS=
DB_PREFIX=dp_

ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_32_CHARS
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5

WISE_API_KEY=
WISE_ENVIRONMENT=sandbox

# TRON: Hot Wallet sends; Ledger receives only.
TRONGRID_API_KEY=
HOT_WALLET_TRC20_ADDRESS=TKST5Ug2UtAq6iQ8wVzy7tTah1FRgWaWYn
HOT_WALLET_TRC20_KEY=
LEDGER_TRC20_ADDRESS=TFyAQPrTRdP7zp46RPmE1iiCac1Lh6Bu58

# Unusual Whales market data (server-side only)
UNUSUAL_WHALES_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENVIRONMENT=test

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENVIRONMENT=sandbox

WEBHOOK_HMAC_SECRET=CHANGE_THIS_TO_RANDOM_SECRET
WEBHOOK_VERIFY_SIGNATURE=false
WEBHOOK_USE_ASYNC_PROCESSING=true

# ============================================================
# PayRam Configuration
# ============================================================
PAYRAM_API_KEY=
PAYRAM_WEBHOOK_SECRET=
PAYRAM_BASE_URL=http://65.2.184.57:8080
