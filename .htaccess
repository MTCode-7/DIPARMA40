# ============================================================
# DI PARMA | .htaccess — الأمان + URL Rewriting
# ============================================================

Options -Indexes
ServerSignature Off
DirectoryIndex landing.php

# Keep the authentication cookie consistent across every PHP page.
<IfModule mod_php.c>
    php_value session.name DIPARMASESSID
    php_value session.cookie_path /
</IfModule>

# ── [1] حماية الملفات الحساسة ────────────────────────────────
<FilesMatch "^(\.env.*|\.git.*|composer\.(json|lock)|package\.json|webpack\.config\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# حماية مجلدات النظام
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Nuvei Test URLs POST to these paths — keep internal rewrite even if html is not PHP-mapped.
    RewriteRule ^nuvei-success\.html$ nuvei-success.php [L,QSA]
    RewriteRule ^nuvei-fail\.html$ nuvei-fail.php [L,QSA]
    RewriteRule ^nuvei-pending\.html$ nuvei-pending.php [L,QSA]
    RewriteRule ^nuvei-back\.html$ nuvei-back.php [L,QSA]

    # الجذر المحلي هو DIPARMA40 نفسه — /DIPARMA40/... يُعاد إلى /
    RewriteRule ^DIPARMA40(?:/(.*))?$ /$1 [R=302,L]

    # منع الوصول المباشر لمجلدات النظام
    RewriteRule ^(includes|config|logs|backups|cache|tmp|lib|protocols)/.*$ - [F,L]

    # DI PARMA API v1 routes are handled by the versioned router.
    RewriteRule ^api/v1/(?:docs?|balance|transactions|charge|refund|void|capture)/?$ api/v1/index.php [L,QSA]

    # Aliases القديمة لصفحات الدفع → checkout/
    RewriteRule ^checkout_paypal\.php$ checkout/paypal.php [R=302,L,QSA]
    RewriteRule ^checkout_stripe\.php$ checkout/stripe.php [R=302,L,QSA]
    RewriteRule ^checkout_nuvei\.php$ checkout/nuvei.php [R=302,L,QSA]
    RewriteRule ^checkout_diparma\.php$ checkout/diparma.php [R=302,L,QSA]
    RewriteRule ^checkout_payram\.php$ checkout/payram.php [R=302,L,QSA]
    RewriteRule ^checkout_wise\.php$ checkout/wise.php [R=302,L,QSA]
    RewriteRule ^checkout_whop\.php$ checkout/whop.php [R=302,L,QSA]
    RewriteRule ^checkout_myfatoorah\.php$ checkout/myfatoorah.php [R=302,L,QSA]
    RewriteRule ^checkout_binance\.php$ checkout/binance.php [R=302,L,QSA]
    RewriteRule ^checkout_gate\.php$ checkout/gate_io.php [R=302,L,QSA]
    RewriteRule ^checkout_mashreq\.php$ checkout/bank_mashreq.php [R=302,L,QSA]
    RewriteRule ^checkout_HSBCbankUAE\.php$ checkout/bank_hsbc.php [R=302,L,QSA]
    RewriteRule ^checkout_NBEbank\.php$ checkout/bank_nbe.php [R=302,L,QSA]
    RewriteRule ^checkout_bank\.php$ checkout/bank_mashreq.php [R=302,L,QSA]
    RewriteRule ^checkout_gateway\.php$ checkout_router.php [R=302,L,QSA]
    RewriteRule ^checkout_offline\.php$ checkout_router.php [R=302,L,QSA]
    RewriteRule ^checkout_live\.php$ pos/index.php [R=302,L,QSA]
    # checkout.php is the Nuvei Back/Failure URL — do not rewrite it away.
    RewriteRule ^pos\.php$ pos/index.php [R=302,L,QSA]
    RewriteRule ^pos_installer\.php$ pos/install.php [L,QSA]
    RewriteRule ^pos_download\.php$ pos/install.php [L,QSA]

    # ── [2] إعادة توجيه HTTP إلى HTTPS ─────────────────────
    # يعمل على السيرفر البعيد تلقائياً — Cloudflare يوفر HTTPS
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteCond %{HTTP_HOST} diparmas\.com [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ── [3] منع تنفيذ PHP في assets وuploads ────────────────
    RewriteRule ^assets/.*\.php$ - [F,L]
    RewriteRule ^uploads/.*\.php$ - [F,L]
</IfModule>

# ── [4] ضغط GZIP كامل ──────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml
    AddOutputFilterByType DEFLATE text/css text/javascript
    AddOutputFilterByType DEFLATE application/json application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE font/truetype font/opentype
    AddOutputFilterByType DEFLATE image/svg+xml
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|ico|webp)$ no-gzip dont-vary
    Header append Vary User-Agent env=!dont-vary
</IfModule>

# ── [5] Cache للملفات الثابتة ───────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png              "access plus 30 days"
    ExpiresByType image/svg+xml          "access plus 30 days"
    ExpiresByType image/x-icon           "access plus 30 days"
</IfModule>

# ── [6] Security Headers ────────────────────────────────────
<IfModule mod_headers.c>
    # Nuvei Test URLs load these paths in an iframe from cpanel.nuvei.com.
    SetEnvIf Request_URI "nuvei-(success|fail|pending|back)\.(html|php)" NUVEI_PROBE
    SetEnvIf Request_URI "nuvei_dmn\.php" NUVEI_PROBE

    # Payment / POS / API / admin — never cache at Cloudflare or browser
    SetEnvIf Request_URI "^/(pos|api|admin|checkout)(/|$)" DIPARMA_NOCACHE
    SetEnvIf Request_URI "checkout_router\.php|login\.php|pay\.php|capture\.php|receipt\.php" DIPARMA_NOCACHE

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN" env=!NUVEI_PROBE
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy "frame-ancestors *" env=NUVEI_PROBE
    Header always set Access-Control-Allow-Origin "*" env=NUVEI_PROBE
    Header always set Access-Control-Allow-Methods "GET, POST, HEAD, OPTIONS" env=NUVEI_PROBE
    Header always set Allow "GET, POST, HEAD, OPTIONS" env=NUVEI_PROBE

    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=DIPARMA_NOCACHE
    Header always set Pragma "no-cache" env=DIPARMA_NOCACHE
    Header always set CDN-Cache-Control "no-store" env=DIPARMA_NOCACHE
    Header always set Cloudflare-CDN-Cache-Control "no-store" env=DIPARMA_NOCACHE
</IfModule>

<FilesMatch "^(nuvei-(success|fail|pending|back)\.(html|php)|nuvei_dmn\.php)$">
    <IfModule mod_headers.c>
        Header always unset X-Frame-Options
        Header always unset X-Content-Type-Options
        Header always set Access-Control-Allow-Origin "*"
        Header always set Access-Control-Allow-Methods "GET, POST, HEAD, OPTIONS"
        Header always set Allow "GET, POST, HEAD, OPTIONS"
        Header always set Content-Security-Policy "frame-ancestors *"
        Header always set Content-Type "text/html; charset=utf-8"
    </IfModule>
</FilesMatch>

# ── حماية مفاتيح RSA والملفات الحساسة ──────────────────────
<FilesMatch "\.(pem|key|crt|p12|pfx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── [7] حماية ملفات السجلات والنسخ الاحتياطية ───────────────
<FilesMatch "^(run_setup_db\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(log|sql|bak|old|swp|orig|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
